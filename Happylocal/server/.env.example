# ---------------------------------------------------------------
# HappyLocal server configuration
# Copy this file to `.env` and fill in the values.
#   cp .env.example .env
# ---------------------------------------------------------------

# 한국관광공사 TourAPI 서비스키 (공공데이터포털 data.go.kr 에서 발급)
#
#   1. https://www.data.go.kr 회원가입
#   2. "한국관광공사_국문 관광정보 서비스_GW" 활용신청
#   3. 마이페이지 > 오픈API > 개발계정 에서 "일반 인증키(Decoding)" 복사
#
# 반드시 *Decoding* 키를 넣으세요. Encoding 키(%2B, %3D 가 섞인 것)를 넣으면
# 서버가 한 번 더 인코딩해서 SERVICE_KEY_IS_NOT_REGISTERED_ERROR 가 납니다.
# 키가 비어 있으면 서버는 시드(목업) 데이터로 정상 기동합니다.
TOUR_API_KEY=

# TourAPI 베이스 URL. 그대로 두세요.
# KorService1 은 폐지되어 모든 오퍼레이션이 400 을 반환합니다 (2026-09-02 실측).
# 오래된 예제에 KorService1 이 나와도 따라가지 마세요.
TOUR_API_BASE=https://apis.data.go.kr/B551011/KorService2

# 지역 코드. 32 = 강원특별자치도
TOUR_AREA_CODE=32

# 시군구 코드 (areaCode=32 기준). 서버가 기동 시 실제 코드표를 조회해
# 자동 검증하고, 다르면 경고를 출력합니다.
TOUR_SIGUNGU_HOENGSEONG=18
TOUR_SIGUNGU_PYEONGCHANG=15
TOUR_SIGUNGU_JEONGSEON=11

# 카카오맵 JavaScript 키 (지도용)
#
#   1. https://developers.kakao.com > 내 애플리케이션 > 애플리케이션 추가
#   2. 앱 키 > "JavaScript 키" 복사
#   3. 플랫폼 > Web > 사이트 도메인에 http://localhost:8787 등록  <-- 필수
#
# 도메인을 등록하지 않으면 지도가 뜨지 않습니다.
# 키가 비어 있으면 기존 Leaflet 지도로 자동 폴백합니다.
KAKAO_JS_KEY=

# ---------------------------------------------------------------
# 카카오 로그인 (소셜 로그인)
# ---------------------------------------------------------------
# 지도용 JavaScript 키와 **다른 키**입니다.
#
#   1. developers.kakao.com > 내 애플리케이션 > (앱) > 앱 설정 > 앱 키
#      -> "REST API 키" 복사
#   2. 제품 설정 > 카카오 로그인 > 활성화 설정 ON
#   3. 제품 설정 > 카카오 로그인 > Redirect URI 등록:
#        http://localhost:8787/api/auth/kakao/callback
#   4. 제품 설정 > 카카오 로그인 > 동의항목에서 닉네임(필수), 이메일(선택) 설정
#
# 비어 있으면 로그인 버튼이 숨겨지고 비로그인 상태로만 동작합니다.
KAKAO_REST_KEY=

# 보안 > Client Secret
#
# 콘솔에서 "사용함" 으로 켜 두고 이 값을 비워 두면, 인가까지는 되고 토큰 교환에서
# KOE010 (Bad client credentials) 로 실패합니다. 화면에는 "리다이렉트 URI 를
# 확인하세요" 처럼 보여서 엉뚱한 곳을 고치기 쉬운 함정입니다.
# 콘솔에서 켰으면 값을 넣고, 안 쓸 거면 콘솔에서 "사용 안 함" 으로 끄세요.
KAKAO_CLIENT_SECRET=

# 배포 시 이 서비스의 공개 주소. Redirect URI 를 만드는 데 씁니다.
# 로컬에서는 비워두면 요청 헤더에서 자동으로 추론합니다.
# 예) https://happylocal.vercel.app
APP_ORIGIN=

# ---------------------------------------------------------------
# 첫 최고관리자
# ---------------------------------------------------------------
# 아무도 super_admin 이 아니면 역할을 줄 사람이 없습니다.
# 여기 적힌 이메일로 로그인하면 자동으로 최고관리자가 됩니다 (쉼표로 여러 명).
# 카카오 로그인에서 이메일 동의항목을 켜 두어야 매칭됩니다.
SUPER_ADMIN_EMAILS=

# 서버 포트
PORT=8787

# TourAPI 응답 캐시 TTL (초). 공공API 일일 호출 한도를 아끼기 위한 값입니다.
CACHE_TTL_SECONDS=3600
